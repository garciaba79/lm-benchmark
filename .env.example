# Evaluation backends
# Copy this file to .env and fill in the keys you need.
# The script only reads the key that matches the backend set in config.py.

# Grok CLI does not need a key (uses ~/.grok/auth.json from the one-time login).

# OpenAI
OPENAI_API_KEY=

# Grok API (xAI)
GROK_API_KEY=

# Google Gemini (OpenAI-compatible endpoint)
GEMINI_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# Optional overrides (usually set in config.py instead)
# EVAL_MODEL=
# OPENAI_BASE_URL=https://api.openai.com/v1
